  m_EditorClassIdentifier: Assembly-CSharp::BossDialogSystem
  speakers:
  - spriteRenderer: {fileID: 212013485}
    imageDialog: {fileID: 1276960477}
    textName: {fileID: 1627027414}
    textDialogue: {fileID: 202364324}
    objectArrow: {fileID: 328196825}
  - spriteRenderer: {fileID: 710391068}
    imageDialog: {fileID: 1673030652}
    textName: {fileID: 1496669589}
    textDialogue: {fileID: 32880620}
    objectArrow: {fileID: 1306966924}
  dialogs:
  - speakerIndex: 1
    name: "\uC218\uB8E1\uC774"
    dialogue: "\uB0B4 \uC218\uC815\uAD6C\uC2AC\uC744 \uB300\uCCB4 \uB204\uAC00 \uD6D4\uCCD0
      \uAC04 \uAC70\uC9C0......\uC7A1\uD788\uBA74 \uAC00\uB9CC \uC548 \uB454\uB2E4!!!!"
  - speakerIndex: 0
    name: ???
    dialogue: "\uD750\uD750\uD750....."
  - speakerIndex: 1
    name: "\uC218\uB8E1\uC774"
    dialogue: "\uC5B4\uBA38 \uB108\uB294....!!"
  - speakerIndex: 1
    name: "\uC218\uB8E1\uC774"
    dialogue: "\uACE0\uC591\uC774\uB098\uBB34...?!?!"
  - speakerIndex: 0
    name: "\uACE0\uC591\uC774\uB098\uBB34"
    dialogue: "\uC73C\uD558\uD558\uD558!!!!! \uC218\uB8E1\uC774 \uB108.... \uB108\uC5D0\uAC90
      \uC774 \uD559\uAD50\uB97C \uC790\uC720\uB86D\uAC8C \uB0A0\uC544\uB2E4\uB2C8\uB294
      \uAC8C \uCC38 \uB2F9\uC5F0\uD558\uACE0\uB3C4 \uC26C\uC6B4 \uC77C\uC774\uACA0\uC9C0"
  - speakerIndex: 0
    name: "\uACE0\uC591\uC774\uB098\uBB34"
    dialogue: "\uD558\uC9C0\uB9CC \uB098\uB294... "
  - speakerIndex: 0
    name: "\uACE0\uC591\uC774\uB098\uBB34"
    dialogue: "\uB098\uB3C4.... \uC774 \uC218\uC815\uAD6C\uC2AC\uC758 \uD798\uC73C\uB85C
      \uACE0\uC591\uC774\uAC00 \uB418\uC5B4 \uC774 \uD559\uAD50\uC758 \uAD00\uC2EC\uC744
      \uB3C5\uCC28\uC9C0\uD558\uACA0\uC5B4!!!!"
  - speakerIndex: 1
    name: "\uC218\uB8E1\uC774"
    dialogue: "\uADF8\uB807\uB2E4\uACE0 \uB0B4 \uAD6C\uC2AC\uC744 \uBE7C\uC557\uC544
      \uAC00\uBA74 \uC548\uB418\uC9C0!!! \uB3CC\uB824\uC918!!!!!"
  - speakerIndex: 0
    name: "\uACE0\uC591\uC774\uB098\uBB34"
    dialogue: "\uD558\uD558!! \uADF8\uB807\uAC8C \uB3CC\uB824\uBC1B\uACE0 \uC2F6\uB2E4\uBA74
      \uBE7C\uC557\uC544 \uBCF4\uC2DC\uB4E0\uAC00!! \uC6B0\uD558\uD558\uD558!!!!"
  isAutoStart: 1
  skillIcon: {fileID: 476553067}
